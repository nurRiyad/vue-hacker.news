{
  "name": "hacker-news",
  "version": "v1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run type-check && vp build",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.config.json",
    "check": "vp check && vp run type-check",
    "test": "vp test",
    "test:watch": "vp test watch",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "@vueuse/head": "^2.0.0",
    "moment": "^2.31.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-content-loader": "^2.0.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
